# Local dev TLS cert/key — host-specific, regenerated by
# vite-plugin-mkcert, never committed (it's a private key).
frontend/certs/

# Real secrets for docker-compose (SMTP credentials, etc.) — copy
# .env.example to .env and fill in real values locally, never commit it.
.env

