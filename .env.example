# Copy this file to .env (which is gitignored — never commit real values)
# and fill in real values to enable actual email delivery. Leave .env
# absent/empty and the app just logs verification codes to the api
# container's console instead — see SECURITY.md.

# Gmail SMTP example: generate an App Password at
# https://myaccount.google.com/apppasswords (NOT your real Gmail password —
# Google requires 2-Step Verification to be on before that page is available).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-address@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM_ADDRESS=your-address@gmail.com
EMAIL_FROM_NAME=Vaultly
